
@CONFIG(
  version    -> "1.0.0"
  
  debug_mode -> "off"
)

@QUICKFUNCS(
  // Explicit filename -> exact path. Wins outright, no search performed.
  ~target<object>(name, path) { return { name = name, path = path } }
)

@DATA(
  // Repo root. Every nested member of the archive carries its own real
  // path (crates/mid-ecs/src/archetype.rs, benches/abi-return-size/...),
  // so each one pins itself with no search and no ambiguity.
  target_root = "."

  // Documentation that lives in this folder, not content to apply.
  // The manifest itself and any dotfile are always excluded anyway.
 // ignore::
    //"README.md"

  // The one flat member in the archive. See the note above for why it is
  // keyed on `ROOT_Cargo.toml` and not on `Cargo.toml`.
  overrides::
    target("ROOT_Cargo.toml", "Cargo.toml")
target("README.md", "README.md")
)
